modules = ["python-3.11", "nodejs-22"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend Build Test"

[[workflows.workflow]]
name = "Frontend Build Test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && npm run build 2>&1"

[workflows.workflow.metadata]
outputType = "console"
